# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NUNCA deve ser commitado num repositório Git.

VOICELINK_BASE_URL=https://172.24.232.145:9444/VoiceLink
VOICELINK_USER=usuario_de_servico
VOICELINK_PASSWORD=senha_aqui

POLL_INTERVAL_SECONDS=60
DB_PATH=control_tower.db

# --- Dashboard ---
# Segundos que cada tela fica no ar no modo apresentação (TV do chão de fábrica)
PRESENTATION_INTERVAL_SECONDS=15
# De quanto em quanto tempo as telas releem o banco
DASHBOARD_REFRESH_SECONDS=15

# --- Contagem de pedidos por operador (coluna "Qtda Pedido") ---
# DESLIGADO por padrão. Ligar só depois de ler a seção 5.2 do README:
# o endpoint envolvido também devolve dados de cliente (nome, endereço,
# CNPJ). O parser descarta tudo isso antes de gravar, mas a chamada em si
# trafega esses dados — então ligar é uma decisão consciente.
COLLECT_ORDER_COUNTS=false
ORDER_POLL_INTERVAL_SECONDS=900
